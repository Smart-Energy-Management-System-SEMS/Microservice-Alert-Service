PORT=8080
SERVER_PORT=8080
AUTO_MIGRATE=true
SERVICE_NAME=alert-service
CONFIG_SERVICE_URL=
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require&channel_binding=require
KAFKA_BROKERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=
KAFKA_SASL_MECHANISM=
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_CONSUMER_GROUP=alert-service-group
KAFKA_CONSUMPTION_TOPIC=energy.consumption.recorded
KAFKA_TOPIC_ALERT_CREATED=alert.created
KAFKA_TOPICS=energy.consumption.recorded,alert.created,alert.sent,payment.completed
GIN_MODE=release

TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
TWILIO_API_KEY=YOUR_TWILIO_API_KEY
TWILIO_API_SECRET=YOUR_TWILIO_API_SECRET
TWILIO_PHONE_NUMBER=+10000000000

MAIL_PORT=587
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=YOUR_GMAIL_APP_PASSWORD
MAIL_FROM=alerts@example.com
