PORT=<azure-container-app-port>
KAFKA_ENABLED=true
DATABASE_URL=<postgres-connection-string>
CONFIG_SERVICE_URL=<config-service-url>
CORS_ALLOWED_ORIGINS=<https://your-frontend.example.com,https://your-admin.example.com>
ALLOWED_ORIGINS=<optional-alternative-origins-list>
KAFKA_BROKERS=<broker1:9092,broker2:9092>
KAFKA_SECURITY_PROTOCOL=<SASL_SSL>
KAFKA_SASL_MECHANISM=<PLAIN>
KAFKA_USERNAME=<kafka-username>
KAFKA_PASSWORD=<kafka-password>
KAFKA_CLIENT_ID=<alert-service-client>
KAFKA_CONSUMER_GROUP=<alert-service-group>
KAFKA_CONSUMPTION_TOPICS=<energy.events,analytics.events>
KAFKA_ALERTS_TOPIC=<alerts.events>
ENVIRONMENT=<azure>
